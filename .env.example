# Copy this file to .env and fill in real values.
# .env is gitignored and will be loaded automatically on startup.

# Port the server listens on (optional, defaults to 3001)
PORT=3001

# Secret used to sign login (JWT) cookies.
# Set a long random string in production. If left unset, the app generates
# and persists one in .jwt_secret automatically.
JWT_SECRET=

# Set to "production" to enable secure cookies (HTTPS only)
NODE_ENV=development

# Daily WhatsApp reminders (times are IST; container may stay in UTC).
# Evening slot reminds devotees of tomorrow's poojas; morning slot confirms
# today's poojas are being performed. Set REMINDERS_ENABLED=false to turn off.
REMINDERS_ENABLED=true
# REMINDER_EVENING_HOUR=17
# REMINDER_EVENING_MIN=0
# REMINDER_MORNING_HOUR=8
# REMINDER_MORNING_MIN=30
# Delay between individual reminder sends, in milliseconds (anti-spam).
# IMPORTANT: Keep this at 15000 or higher to reduce ban risk.
# REMINDER_DELAY_MS=15000
# Hard cap on sends per reminder slot (morning or evening).
# Set to 0 for no cap. Default 100 to prevent runaway spam.
# REMINDER_MAX_SENDS_PER_SLOT=100
