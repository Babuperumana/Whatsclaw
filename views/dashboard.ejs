<!DOCTYPE html>
<html lang="en" class="light-style layout-menu-fixed layout-compact" dir="ltr" data-theme="theme-default">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>
        <%= site.brand_name %> | Dashboard
    </title>
    <!-- Basic Bootstrap for UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f5f5f9;
            font-family: 'Inter', sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #fff;
            box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.075);
        }

        .stat-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 0.25rem 1rem rgba(161, 172, 184, 0.2);
        }

        .card-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 24px;
        }
    </style>
</head>

<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <div class="text-center mb-4 mt-2">
                    <h5>
                        <%= site.brand_name %>
                    </h5>
                </div>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-primary" href="/dashboard"><i
                                class="bi bi-house-door me-2"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/vazhipadu"><i class="bi bi-flower1 me-2"></i>
                            Vazhipadu Master</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/specialdays"><i
                                class="bi bi-calendar-event me-2"></i> Special Days</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/nakshathrapooja"><i
                                class="bi bi-stars me-2"></i> Nakshathra Poojas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/whatsapp"><i
                                class="bi bi-whatsapp me-2"></i> WhatsApp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/transactions"><i class="bi bi-list-check me-2"></i> Transactions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#"><i class="bi bi-shop me-2"></i> Connect Merchant</a>
                    </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>
                            Logout</a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>Welcome back, <%= user.name %>! 🎉</h4>
                    <span class="badge bg-primary fs-6"><i class="bi bi-person"></i>
                        <%= user.mobile %>
                    </span>
                </div>

                <!-- Stats Row -->
                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-success text-white me-3"><i class="bi bi-currency-rupee"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Collection</h6>
                                    <h4 class="mb-0">₹ <%= stats.todaySuccessAmt %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-info text-white me-3"><i class="bi bi-check-circle"></i></div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Success</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todaySuccessCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-warning text-white me-3"><i class="bi bi-hourglass-split"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Pending</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todayPendingCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-danger text-white me-3"><i class="bi bi-x-circle"></i></div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Failed</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todayFailureCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="card stat-card">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Recent Transactions (Last 10)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Amount</th>
                                        <th>Payer Name</th>
                                        <th>Payment App</th>
                                        <th>Status</th>
                                        <th>UTR</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentOrders.length> 0) { %>
                                        <% recentOrders.forEach(order=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= order.order_id %>
                                                    </span></td>
                                                <td>₹ <%= order.amount %>
                                                </td>
                                                <td>
                                                    <% if (order.payer_name) { %>
                                                        <%= order.payer_name %>
                                                            <% } else { %>
                                                                -
                                                                <% } %>
                                                </td>
                                                <td>
                                                    <% if (order.payer_handle) { %>
                                                        <span class="badge bg-light text-dark border">
                                                            <%= order.payer_handle %>
                                                        </span>
                                                        <% } else { %>
                                                            -
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <% if (order.status==='SUCCESS' ) { %>
                                                        <span class="badge bg-success">SUCCESS</span>
                                                        <% } else if (order.status==='FAILURE' ) { %>
                                                            <span class="badge bg-danger">FAILURE</span>
                                                            <% } else { %>
                                                                <span class="badge bg-warning text-dark">PENDING</span>
                                                                <% } %>
                                                </td>
                                                <td>
                                                    <%= order.utr ? order.utr : '-' %>
                                                </td>
                                                <td>
                                                    <%= order.create_date %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4">No recent transactions
                                                            found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Vazhipadu Bookings -->
                <div class="card stat-card mt-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Recent Vazhipadu Bookings (WhatsApp)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Phone Number</th>
                                        <th>Vazhipadu</th>
                                        <th>Devotee Name</th>
                                        <th>Nakshathram</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof recentVazhipadu !=='undefined' && recentVazhipadu.length> 0) { %>
                                        <% recentVazhipadu.forEach(v=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= v.order_id %>
                                                    </span></td>
                                                <td>
                                                    <%= v.phone_number %>
                                                </td>
                                                <td>
                                                    <%= v.vazhipadu_name %>
                                                </td>
                                                <td>
                                                    <%= v.devotee_name %>
                                                </td>
                                                <td>
                                                    <%= v.nakshathram %>
                                                </td>
                                                <td>
                                                    <%= v.performing_date %>
                                                </td>
                                                <td>₹ <%= v.amount %>
                                                </td>
                                                <td><span class="badge bg-secondary">
                                                        <%= v.payment_mode %>
                                                    </span></td>
                                                <td>
                                                    <% if (v.status==='CONFIRMED' ) { %>
                                                        <span class="badge bg-success">CONFIRMED</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">
                                                                <%= v.status %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="9" class="text-center py-4">No recent vazhipadu
                                                            bookings found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Donations -->
                <div class="card stat-card mt-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Recent Donations (WhatsApp)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Phone Number</th>
                                        <th>WhatsApp Name</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof recentDonations !=='undefined' && recentDonations.length> 0) { %>
                                        <% recentDonations.forEach(d=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= d.order_id %>
                                                    </span></td>
                                                <td>
                                                    <%= d.phone_number %>
                                                </td>
                                                <td>
                                                    <%= d.whatsapp_name || '-' %>
                                                </td>
                                                <td>₹ <%= d.amount %>
                                                </td>
                                                <td><span class="badge bg-secondary">
                                                        <%= d.payment_mode %>
                                                    </span></td>
                                                <td>
                                                    <% if (d.status==='CONFIRMED' ) { %>
                                                        <span class="badge bg-success">CONFIRMED</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">
                                                                <%= d.status %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <%= d.created_at %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4">No recent donations
                                                            found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

</html>