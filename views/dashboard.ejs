<!DOCTYPE html>
<html lang="en" class="light-style layout-menu-fixed layout-compact" dir="ltr" data-theme="theme-default">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>
        <%= site.brand_name %> | Dashboard
    </title>
    <!-- Basic Bootstrap for UI -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f5f5f9;
            font-family: 'Inter', sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #fff;
            box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.075);
        }

        .stat-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 0.25rem 1rem rgba(161, 172, 184, 0.2);
        }

        .card-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 24px;
        }

        .role-badge {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
</head>

<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <div class="text-center mb-4 mt-2">
                    <h5>
                        <%= site.brand_name %>
                    </h5>
                </div>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-primary" href="/dashboard"><i
                                class="bi bi-house-door me-2"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/vazhipadu"><i class="bi bi-flower1 me-2"></i>
                            Vazhipadu Items</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/dashboard/specialdays"><i
                                    class="bi bi-calendar-event me-2"></i> Special Days</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/dashboard/nakshathrapooja"><i
                                    class="bi bi-stars me-2"></i> Janma Nakshathra Poojas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/dashboard/whatsapp"><i class="bi bi-whatsapp me-2"></i> WhatsApp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/dashboard/transactions"><i class="bi bi-list-check me-2"></i> Transactions</a>
                        </li>
                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/dashboard/users"><i class="bi bi-people me-2"></i> User Management</a>
                        </li>
                        <% } %>
                    </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>
                            Logout</a>
                    </li>
                </ul>
                <div class="mt-auto pt-4 border-top">
                    <span class="badge role-badge
                        <% if (userRole === 'superadmin') { %>bg-danger<% } else if (userRole === 'admin') { %>bg-warning text-dark<% } else { %>bg-secondary<% } %>">
                        <%= userRole %>
                    </span>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>Welcome back, <%= user.name %>! 🎉</h4>
                    <span class="badge bg-primary fs-6"><i class="bi bi-person"></i>
                        <%= user.mobile %>
                    </span>
                </div>

                <!-- Stats Row -->
                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-success text-white me-3"><i class="bi bi-currency-rupee"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Collection</h6>
                                    <h4 class="mb-0">₹ <%= stats.todaySuccessAmt %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-info text-white me-3"><i class="bi bi-check-circle"></i></div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Success</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todaySuccessCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-warning text-white me-3"><i class="bi bi-hourglass-split"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Pending</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todayPendingCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card p-3">
                            <div class="d-flex align-items-center">
                                <div class="card-icon bg-danger text-white me-3"><i class="bi bi-x-circle"></i></div>
                                <div>
                                    <h6 class="mb-0 text-muted">Today's Failed</h6>
                                    <h4 class="mb-0">
                                        <%= stats.todayFailureCount %>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="card stat-card">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Transactions (Last 10)</h5>
                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addOrderModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Order
                        </button>
                        <% } %>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Amount</th>
                                        <th>Payer Name</th>
                                        <th>Payment App</th>
                                        <th>Status</th>
                                        <th>UTR</th>
                                        <th>Date</th>
                                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                        <th class="text-center">Actions</th>
                                        <% } %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentOrders.length> 0) { %>
                                        <% recentOrders.forEach(order=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= order.order_id %>
                                                    </span></td>
                                                <td>₹ <%= order.amount %>
                                                </td>
                                                <td>
                                                    <% if (order.payer_name) { %>
                                                        <%= order.payer_name %>
                                                            <% } else { %>
                                                                -
                                                                <% } %>
                                                </td>
                                                <td>
                                                    <% if (order.payer_handle) { %>
                                                        <span class="badge bg-light text-dark border">
                                                            <%= order.payer_handle %>
                                                        </span>
                                                        <% } else { %>
                                                            -
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <% if (order.status==='SUCCESS' ) { %>
                                                        <span class="badge bg-success">SUCCESS</span>
                                                        <% } else if (order.status==='FAILURE' ) { %>
                                                            <span class="badge bg-danger">FAILURE</span>
                                                            <% } else { %>
                                                                <span class="badge bg-warning text-dark">PENDING</span>
                                                                <% } %>
                                                </td>
                                                <td>
                                                    <%= order.utr ? order.utr : '-' %>
                                                </td>
                                                <td>
                                                    <%= order.create_date %>
                                                </td>
                                                <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary edit-order-btn"
                                                            data-id="<%= order.id %>"
                                                            data-order_id="<%= order.order_id %>"
                                                            data-amount="<%= order.amount %>"
                                                            data-payer_name="<%= order.payer_name || '' %>"
                                                            data-payer_handle="<%= order.payer_handle || '' %>"
                                                            data-status="<%= order.status %>"
                                                            data-utr="<%= order.utr || '' %>">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <% if (userRole === 'superadmin') { %>
                                                    <form method="POST" action="/dashboard/transactions/order/delete/<%= order.id %>" class="d-inline" onsubmit="return confirm('Delete this order?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                    <% } %>
                                                </td>
                                                <% } %>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="<%= (userRole === 'superadmin' || userRole === 'admin') ? '8' : '7' %>" class="text-center py-4">No recent transactions found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Vazhipadu Bookings -->
                <div class="card stat-card mt-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Vazhipadu Bookings (WhatsApp)</h5>
                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addVazhipaduModal">
                            <i class="bi bi-plus-circle me-1"></i> Add
                        </button>
                        <% } %>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Phone Number</th>
                                        <th>Vazhipadu</th>
                                        <th>Devotee Name</th>
                                        <th>Nakshathram</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Status</th>
                                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                        <th class="text-center">Actions</th>
                                        <% } %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof recentVazhipadu !=='undefined' && recentVazhipadu.length> 0) { %>
                                        <% recentVazhipadu.forEach(v=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= v.order_id %>
                                                    </span></td>
                                                <td>
                                                    <%= v.phone_number %>
                                                </td>
                                                <td>
                                                    <%= v.vazhipadu_name %>
                                                </td>
                                                <td>
                                                    <%= v.devotee_name %>
                                                </td>
                                                <td>
                                                    <%= v.nakshathram %>
                                                </td>
                                                <td>
                                                    <%= v.performing_date %>
                                                </td>
                                                <td>₹ <%= v.amount %>
                                                </td>
                                                <td><span class="badge bg-secondary">
                                                        <%= v.payment_mode %>
                                                    </span></td>
                                                <td>
                                                    <% if (v.status==='CONFIRMED' ) { %>
                                                        <span class="badge bg-success">CONFIRMED</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">
                                                                <%= v.status %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary edit-vazhipadu-btn"
                                                            data-id="<%= v.id %>"
                                                            data-order_id="<%= v.order_id %>"
                                                            data-phone_number="<%= v.phone_number %>"
                                                            data-vazhipadu_name="<%= v.vazhipadu_name %>"
                                                            data-devotee_name="<%= v.devotee_name %>"
                                                            data-nakshathram="<%= v.nakshathram %>"
                                                            data-performing_date="<%= v.performing_date %>"
                                                            data-amount="<%= v.amount %>"
                                                            data-payment_mode="<%= v.payment_mode %>"
                                                            data-status="<%= v.status %>">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <% if (userRole === 'superadmin') { %>
                                                    <form method="POST" action="/dashboard/transactions/vazhipadu/delete/<%= v.id %>" class="d-inline" onsubmit="return confirm('Delete this booking?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                    <% } %>
                                                </td>
                                                <% } %>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="<%= (userRole === 'superadmin' || userRole === 'admin') ? '10' : '9' %>" class="text-center py-4">No recent vazhipadu
                                                            bookings found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Donations -->
                <div class="card stat-card mt-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Donations (WhatsApp)</h5>
                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDonationModal">
                            <i class="bi bi-plus-circle me-1"></i> Add
                        </button>
                        <% } %>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Phone Number</th>
                                        <th>WhatsApp Name</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                        <th class="text-center">Actions</th>
                                        <% } %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof recentDonations !=='undefined' && recentDonations.length> 0) { %>
                                        <% recentDonations.forEach(d=> { %>
                                            <tr>
                                                <td><span class="text-primary fw-bold">
                                                        <%= d.order_id %>
                                                    </span></td>
                                                <td>
                                                    <%= d.phone_number %>
                                                </td>
                                                <td>
                                                    <%= d.whatsapp_name || '-' %>
                                                </td>
                                                <td>₹ <%= d.amount %>
                                                </td>
                                                <td><span class="badge bg-secondary">
                                                        <%= d.payment_mode %>
                                                    </span></td>
                                                <td>
                                                    <% if (d.status==='CONFIRMED' ) { %>
                                                        <span class="badge bg-success">CONFIRMED</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">
                                                                <%= d.status %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <%= d.created_at %>
                                                </td>
                                                <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-outline-primary edit-donation-btn"
                                                            data-id="<%= d.id %>"
                                                            data-order_id="<%= d.order_id %>"
                                                            data-phone_number="<%= d.phone_number %>"
                                                            data-whatsapp_name="<%= d.whatsapp_name || '' %>"
                                                            data-amount="<%= d.amount %>"
                                                            data-payment_mode="<%= d.payment_mode %>"
                                                            data-status="<%= d.status %>"
                                                            data-purpose="<%= d.purpose || '' %>">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <% if (userRole === 'superadmin') { %>
                                                    <form method="POST" action="/dashboard/transactions/donation/delete/<%= d.id %>" class="d-inline" onsubmit="return confirm('Delete this donation?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                    <% } %>
                                                </td>
                                                <% } %>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="<%= (userRole === 'superadmin' || userRole === 'admin') ? '8' : '7' %>" class="text-center py-4">No recent donations
                                                            found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ── Modals (only rendered for superadmin/admin) ── -->
    <% if (userRole === 'superadmin' || userRole === 'admin') { %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Order Add/Edit
        const orderForm = document.getElementById('orderForm');
        const orderModalTitle = document.getElementById('orderModalTitle');
        const orderFormAction = document.getElementById('orderFormAction');
        document.querySelectorAll('.edit-order-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('orderIdField').value = btn.dataset.id || '';
                document.getElementById('orderOrderId').value = btn.dataset.order_id || '';
                document.getElementById('orderAmount').value = btn.dataset.amount || '';
                document.getElementById('orderPayerName').value = btn.dataset.payer_name || '';
                document.getElementById('orderPayerHandle').value = btn.dataset.payer_handle || '';
                document.getElementById('orderStatus').value = btn.dataset.status || 'PENDING';
                document.getElementById('orderUtr').value = btn.dataset.utr || '';
                orderFormAction.value = btn.dataset.id ? `/dashboard/transactions/order/update/${btn.dataset.id}` : '/dashboard/transactions/order/create';
                orderModalTitle.textContent = btn.dataset.id ? 'Edit Order' : 'Add Order';
            });
        });

        // Vazhipadu Add/Edit
        const vazhipaduForm = document.getElementById('vazhipaduForm');
        const vazhipaduModalTitle = document.getElementById('vazhipaduModalTitle');
        const vazhipaduFormAction = document.getElementById('vazhipaduFormAction');
        document.querySelectorAll('.edit-vazhipadu-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('vazhipaduIdField').value = btn.dataset.id || '';
                document.getElementById('vazhipaduOrderId').value = btn.dataset.order_id || '';
                document.getElementById('vazhipaduPhone').value = btn.dataset.phone_number || '';
                document.getElementById('vazhipaduName').value = btn.dataset.vazhipadu_name || '';
                document.getElementById('vazhipaduDevotee').value = btn.dataset.devotee_name || '';
                document.getElementById('vazhipaduNakshathram').value = btn.dataset.nakshathram || '';
                document.getElementById('vazhipaduDate').value = btn.dataset.performing_date || '';
                document.getElementById('vazhipaduAmount').value = btn.dataset.amount || '';
                document.getElementById('vazhipaduMode').value = btn.dataset.payment_mode || 'COUNTER';
                document.getElementById('vazhipaduStatus').value = btn.dataset.status || 'PENDING';
                vazhipaduFormAction.value = btn.dataset.id ? `/dashboard/transactions/vazhipadu/update/${btn.dataset.id}` : '/dashboard/transactions/vazhipadu/create';
                vazhipaduModalTitle.textContent = btn.dataset.id ? 'Edit Vazhipadu' : 'Add Vazhipadu';
            });
        });

        // Donation Add/Edit
        const donationForm = document.getElementById('donationForm');
        const donationModalTitle = document.getElementById('donationModalTitle');
        const donationFormAction = document.getElementById('donationFormAction');
        document.querySelectorAll('.edit-donation-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('donationIdField').value = btn.dataset.id || '';
                document.getElementById('donationOrderId').value = btn.dataset.order_id || '';
                document.getElementById('donationPhone').value = btn.dataset.phone_number || '';
                document.getElementById('donationWhatsappName').value = btn.dataset.whatsapp_name || '';
                document.getElementById('donationAmount').value = btn.dataset.amount || '';
                document.getElementById('donationMode').value = btn.dataset.payment_mode || 'COUNTER';
                document.getElementById('donationStatus').value = btn.dataset.status || 'PENDING';
                document.getElementById('donationPurpose').value = btn.dataset.purpose || '';
                donationFormAction.value = btn.dataset.id ? `/dashboard/transactions/donation/update/${btn.dataset.id}` : '/dashboard/transactions/donation/create';
                donationModalTitle.textContent = btn.dataset.id ? 'Edit Donation' : 'Add Donation';
            });
        });
    </script>

    <!-- Order Modal -->
    <div class="modal fade" id="addOrderModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="orderForm" method="POST" action="/dashboard/transactions/order/create">
                    <div class="modal-header">
                        <h5 class="modal-title" id="orderModalTitle">Add Order</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="orderIdField" name="id">
                        <input type="hidden" id="orderFormAction" name="_action">
                        <div class="mb-2"><label class="form-label">Order ID *</label>
                            <input type="text" class="form-control" id="orderOrderId" name="order_id" required></div>
                        <div class="mb-2"><label class="form-label">Amount *</label>
                            <input type="number" step="0.01" class="form-control" id="orderAmount" name="amount" required></div>
                        <div class="mb-2"><label class="form-label">Payer Name</label>
                            <input type="text" class="form-control" id="orderPayerName" name="payer_name"></div>
                        <div class="mb-2"><label class="form-label">Payment App</label>
                            <input type="text" class="form-control" id="orderPayerHandle" name="payer_handle"></div>
                        <div class="mb-2"><label class="form-label">Status</label>
                            <select class="form-select" id="orderStatus" name="status">
                                <option value="PENDING">PENDING</option>
                                <option value="SUCCESS">SUCCESS</option>
                                <option value="FAILURE">FAILURE</option>
                            </select></div>
                        <div class="mb-2"><label class="form-label">UTR</label>
                            <input type="text" class="form-control" id="orderUtr" name="utr"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Vazhipadu Modal -->
    <div class="modal fade" id="addVazhipaduModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="vazhipaduForm" method="POST" action="/dashboard/transactions/vazhipadu/create">
                    <div class="modal-header">
