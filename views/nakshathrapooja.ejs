<!DOCTYPE html>
<html lang="en" class="light-style layout-menu-fixed layout-compact" dir="ltr" data-theme="theme-default">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>
        <%= site.brand_name %> | Nakshathra Poojas
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f5f5f9;
            font-family: 'Inter', sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #fff;
            box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.075);
        }

        .stat-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 0.25rem 1rem rgba(161, 172, 184, 0.2);
        }
    </style>
</head>

<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <div class="text-center mb-4 mt-2">
                    <h5>
                        <%= site.brand_name %>
                    </h5>
                </div>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-house-door me-2"></i>
                            Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/vazhipadu"><i
                                class="bi bi-flower1 me-2"></i> Vazhipadu Master</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/specialdays"><i
                                class="bi bi-calendar-event me-2"></i> Special Days</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-primary" href="/dashboard/nakshathrapooja"><i
                                class="bi bi-stars me-2"></i> Nakshathra Poojas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/whatsapp"><i class="bi bi-whatsapp me-2"></i> WhatsApp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/devotees"><i class="bi bi-people me-2"></i> Devotees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#"><i class="bi bi-list-check me-2"></i> Transactions</a>
                    </li>
                    <% if (typeof userRole !== 'undefined' && (userRole === 'superadmin' || userRole === 'admin')) { %>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/users"><i class="bi bi-people me-2"></i> User Management</a>
                    </li>
                    <% } %>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>
                            Logout</a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>Nakshathra Poojas</h4>
                    <% if (typeof userRole === 'undefined' || userRole === 'superadmin' || userRole === 'admin') { %>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus-lg"></i> Add Nakshathra Pooja
                    </button>
                    <% } %>
                </div>

                <!-- Flash Messages -->
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>
                        <% if (typeof error !=='undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <p class="text-muted">
                                    Register devotees for a monthly nakshathra pooja. Devotees can see the next
                                    pooja date for their nakshathram from the Settings menu on WhatsApp.
                                </p>

                                <!-- Items Table -->
                                <div class="card stat-card">
                                    <div class="card-header bg-white py-3">
                                        <h5 class="mb-0">All Nakshathra Poojas</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Name</th>
                                                        <th>Nakshathram</th>
                                                        <th>WhatsApp Number</th>
                                                        <th>Status</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (items.length> 0) { %>
                                                        <% items.forEach(item=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= item.id %>
                                                                </td>
                                                                <td>
                                                                    <%= item.name %>
                                                                </td>
                                                                <td>
                                                                    <%= item.nakshathram %>
                                                                </td>
                                                                <td>
                                                                    <%= item.whatsapp_number %>
                                                                </td>
                                                                <td>
                                                                    <% if (item.status==='ACTIVE' ) { %>
                                                                        <span class="badge bg-success">Active</span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="badge bg-secondary">Inactive</span>
                                                                            <% } %>
                                                                </td>
                                                                <td class="text-end">
                                                                    <% if (typeof userRole !== 'undefined' && (userRole === 'superadmin' || userRole === 'admin')) { %>
                                                                    <button class="btn btn-sm btn-outline-primary"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#editModal<%= item.id %>">
                                                                        <i class="bi bi-pencil"></i> Edit
                                                                    </button>
                                                                    <button class="btn btn-sm btn-outline-danger"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteModal<%= item.id %>">
                                                                        <i class="bi bi-trash"></i> Delete
                                                                    </button>
                                                                    <% } %>
                                                                </td>
                                                            </tr>

                                                            <!-- Edit Modal -->
                                                            <div class="modal fade" id="editModal<%= item.id %>"
                                                                tabindex="-1">
                                                                <div class="modal-dialog">
                                                                    <div class="modal-content">
                                                                        <form
                                                                            action="/dashboard/nakshathrapooja/update/<%= item.id %>"
                                                                            method="POST">
                                                                            <div class="modal-header">
                                                                                <h5 class="modal-title">Edit Nakshathra
                                                                                    Pooja</h5>
                                                                                <button type="button" class="btn-close"
                                                                                    data-bs-dismiss="modal"></button>
                                                                            </div>
                                                                            <div class="modal-body">
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Name</label>
                                                                                    <input type="text"
                                                                                        class="form-control" name="name"
                                                                                        value="<%= item.name %>"
                                                                                        required>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label
                                                                                        class="form-label">Nakshathram</label>
                                                                                    <select class="form-select"
                                                                                        name="nakshathram" required>
                                                                                        <% nakshatrams.forEach(n=> { %>
                                                                                            <option value="<%= n %>" <%=item.nakshathram===n ? 'selected' : '' %>>
                                                                                                <%= n %>
                                                                                            </option>
                                                                                            <% }) %>
                                                                                    </select>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">WhatsApp
                                                                                        Number</label>
                                                                                    <input type="text"
                                                                                        class="form-control"
                                                                                        name="whatsapp_number"
                                                                                        value="<%= item.whatsapp_number %>"
                                                                                        required>
                                                                                    <small class="text-muted">Digits
                                                                                        with country code, e.g.
                                                                                        918907959595.</small>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label
                                                                                        class="form-label">Status</label>
                                                                                    <select class="form-select"
                                                                                        name="status">
                                                                                        <option value="ACTIVE" <%=item.status==='ACTIVE' ? 'selected' : '' %>>Active</option>
                                                                                        <option value="INACTIVE" <%=item.status==='INACTIVE' ? 'selected' : '' %>>Inactive</option>
                                                                                    </select>
                                                                                </div>
                                                                            </div>
                                                                            <div class="modal-footer">
                                                                                <button type="button"
                                                                                    class="btn btn-secondary"
                                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                                <button type="submit"
                                                                                    class="btn btn-primary">Save
                                                                                    Changes</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Delete Modal -->
                                                            <div class="modal fade" id="deleteModal<%= item.id %>"
                                                                tabindex="-1">
                                                                <div class="modal-dialog">
                                                                    <div class="modal-content">
                                                                        <form
                                                                            action="/dashboard/nakshathrapooja/delete/<%= item.id %>"
                                                                            method="POST">
                                                                            <div class="modal-header">
                                                                                <h5 class="modal-title">Delete Nakshathra
                                                                                    Pooja</h5>
                                                                                <button type="button" class="btn-close"
                                                                                    data-bs-dismiss="modal"></button>
                                                                            </div>
                                                                            <div class="modal-body">
                                                                                Are you sure you want to delete the
                                                                                nakshathra pooja for
                                                                                <strong>
                                                                                    <%= item.name %>
                                                                                </strong> (<%= item.nakshathram %>)?
                                                                            </div>
                                                                            <div class="modal-footer">
                                                                                <button type="button"
                                                                                    class="btn btn-secondary"
                                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                                <button type="submit"
                                                                                    class="btn btn-danger">Delete</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="6" class="text-center text-muted py-4">
                                                                            No nakshathra poojas yet. Click "Add
                                                                            Nakshathra Pooja" to create one.
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
            </div>
        </div>
    </div>

    <!-- Add Modal -->
    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/dashboard/nakshathrapooja/create" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Nakshathra Pooja</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" name="name" required>
                            <small class="text-muted">Person the pooja is performed for.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nakshathram</label>
                            <select class="form-select" name="nakshathram" required>
                                <option value="" selected disabled>Select nakshathram</option>
                                <% nakshatrams.forEach(n=> { %>
                                    <option value="<%= n %>">
                                        <%= n %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">WhatsApp Number</label>
                            <input type="text" class="form-control" name="whatsapp_number" required>
                            <small class="text-muted">Digits with country code, e.g. 918907959595.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status">
                                <option value="ACTIVE" selected>Active</option>
                                <option value="INACTIVE">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Nakshathra Pooja</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
