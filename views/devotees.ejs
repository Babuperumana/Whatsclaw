<!DOCTYPE html>
<html lang="en" class="light-style layout-menu-fixed layout-compact" dir="ltr" data-theme="theme-default">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>
        <%= site.brand_name %> | Devotees
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f5f5f9;
            font-family: 'Inter', sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #fff;
            box-shadow: 0 0.125rem 0.25rem rgba(161, 172, 184, 0.075);
        }

        .stat-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 0.25rem 1rem rgba(161, 172, 184, 0.2);
        }
    </style>
</head>

<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <div class="text-center mb-4 mt-2">
                    <h5>
                        <%= site.brand_name %>
                    </h5>
                </div>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard"><i class="bi bi-house-door me-2"></i>
                            Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/vazhipadu"><i
                                class="bi bi-flower1 me-2"></i> Vazhipadu Master</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/specialdays"><i
                                class="bi bi-calendar-event me-2"></i> Special Days</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/nakshathrapooja"><i
                                class="bi bi-stars me-2"></i> Nakshathra Poojas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active fw-bold text-primary" href="/dashboard/devotees"><i
                                class="bi bi-people me-2"></i> Devotees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/whatsapp"><i class="bi bi-whatsapp me-2"></i> WhatsApp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/transactions"><i class="bi bi-list-check me-2"></i> Transactions</a>
                    </li>
                    <% if (typeof userRole !== 'undefined' && (userRole === 'superadmin' || userRole === 'admin')) { %>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/dashboard/users"><i class="bi bi-person-gear me-2"></i> User Management</a>
                    </li>
                    <% } %>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>
                            Logout</a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>Devotees</h4>
                    <% if (userRole === 'superadmin' || userRole === 'admin' || userRole === 'staff') { %>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus-lg"></i> Add Devotee
                    </button>
                    <% } %>
                </div>

                <!-- Flash Messages -->
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>
                        <% if (typeof error !=='undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <p class="text-muted">
                                    Devotees registered via WhatsApp. Phone number is the unique identifier.
                                    Language preference is used for WhatsApp message localization.
                                </p>

                                <!-- Summary Cards -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <div class="card stat-card p-3">
                                            <div class="d-flex align-items-center">
                                                <div class="card-icon bg-primary text-white me-3"><i class="bi bi-people"></i></div>
                                                <div>
                                                    <h6 class="mb-0 text-muted">Total Devotees</h6>
                                                    <h4 class="mb-0"><%= devotees.length %></h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card stat-card p-3">
                                            <div class="d-flex align-items-center">
                                                <div class="card-icon bg-success text-white me-3"><i class="bi bi-translate"></i></div>
                                                <div>
                                                    <h6 class="mb-0 text-muted">Languages</h6>
                                                    <h4 class="mb-0"><%= devotees.filter(d => d.language).map(d => d.language).filter((v, i, a) => a.indexOf(v) === i).length %></h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card stat-card p-3">
                                            <div class="d-flex align-items-center">
                                                <div class="card-icon bg-info text-white me-3"><i class="bi bi-whatsapp"></i></div>
                                                <div>
                                                    <h6 class="mb-0 text-muted">WhatsApp Linked</h6>
                                                    <h4 class="mb-0"><%= devotees.filter(d => d.whatsapp_name).length %></h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Devotees Table -->
                                <div class="card stat-card">
                                    <div class="card-header bg-white py-3">
                                        <h5 class="mb-0">All Devotees</h5>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Phone Number</th>
                                                        <th>WhatsApp Name</th>
                                                        <th>Language</th>
                                                        <th>Registered</th>
                                                        <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                                        <th class="text-end">Actions</th>
                                                        <% } %>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (devotees.length> 0) { %>
                                                        <% devotees.forEach(d=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= d.id %>
                                                                </td>
                                                                <td>
                                                                    <span class="text-primary fw-bold">
                                                                        <%= d.phone_number %>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <%= d.whatsapp_name || '<span class="text-muted">—</span>' %>
                                                                </td>
                                                                <td>
                                                                    <% if (d.language) { %>
                                                                        <span class="badge bg-light text-dark border">
                                                                            <%= d.language %>
                                                                        </span>
                                                                    <% } else { %>
                                                                        <span class="text-muted">—</span>
                                                                    <% } %>
                                                                </td>
                                                                <td>
                                                                    <%= d.created_at %>
                                                                </td>
                                                                <% if (userRole === 'superadmin' || userRole === 'admin' || userRole === 'staff') { %>
                                                                <td class="text-end">
                                                                    <button class="btn btn-sm btn-outline-primary"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#editModal<%= d.id %>">
                                                                        <i class="bi bi-pencil"></i> Edit
                                                                    </button>
                                                                    <% if (userRole === 'superadmin' || userRole === 'admin') { %>
                                                                    <button class="btn btn-sm btn-outline-danger ms-1"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteModal<%= d.id %>">
                                                                        <i class="bi bi-trash"></i> Delete
                                                                    </button>
                                                                    <% } %>
                                                                </td>
                                                                <% } %>
                                                            </tr>

                                                            <!-- Edit Modal -->
                                                            <div class="modal fade" id="editModal<%= d.id %>"
                                                                tabindex="-1">
                                                                <div class="modal-dialog">
                                                                    <div class="modal-content">
                                                                        <form
                                                                            action="/dashboard/devotees/update/<%= d.id %>"
                                                                            method="POST">
                                                                            <div class="modal-header">
                                                                                <h5 class="modal-title">Edit Devotee
                                                                                </h5>
                                                                                <button type="button" class="btn-close"
                                                                                    data-bs-dismiss="modal"></button>
                                                                            </div>
                                                                            <div class="modal-body">
                                                                                <div class="mb-3">
                                                                                    <label
                                                                                        class="form-label">Phone Number *</label>
                                                                                    <input type="text"
                                                                                        class="form-control" name="phone_number"
                                                                                        value="<%= d.phone_number %>"
                                                                                        required>
                                                                                    <small class="text-muted">Digits with country
                                                                                        code, e.g. 918907959595.</small>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">WhatsApp Name</label>
                                                                                    <input type="text"
                                                                                        class="form-control" name="whatsapp_name"
                                                                                        value="<%= d.whatsapp_name || '' %>">
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Language</label>
                                                                                    <select class="form-select" name="language">
                                                                                        <option value="">— Not set —</option>
                                                                                        <% languages.forEach(lang=> { %>
                                                                                            <option value="<%= lang %>" <%=d.language===lang ? 'selected' : '' %>>
                                                                                                <%= lang %>
                                                                                            </option>
                                                                                            <% }) %>
                                                                                    </select>
                                                                                </div>
                                                                            </div>
                                                                            <div class="modal-footer">
                                                                                <button type="button"
                                                                                    class="btn btn-secondary"
                                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                                <button type="submit"
                                                                                    class="btn btn-primary">Save
                                                                                    Changes</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Delete Modal -->
                                                            <div class="modal fade" id="deleteModal<%= d.id %>"
                                                                tabindex="-1">
                                                                <div class="modal-dialog">
                                                                    <div class="modal-content">
                                                                        <form
                                                                            action="/dashboard/devotees/delete/<%= d.id %>"
                                                                            method="POST">
                                                                            <div class="modal-header">
                                                                                <h5 class="modal-title">Delete Devotee
                                                                                </h5>
                                                                                <button type="button" class="btn-close"
                                                                                    data-bs-dismiss="modal"></button>
                                                                            </div>
                                                                            <div class="modal-body">
                                                                                Are you sure you want to delete
                                                                                devotee <strong>
                                                                                    <%= d.phone_number %>
                                                                                </strong><% if (d.whatsapp_name) { %> (<%= d.whatsapp_name %>)<% } %>?
                                                                            </div>
                                                                            <div class="modal-footer">
                                                                                <button type="button"
                                                                                    class="btn btn-secondary"
                                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                                <button type="submit"
                                                                                    class="btn btn-danger">Delete</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="<%= (userRole === 'superadmin' || userRole === 'admin' || userRole === 'staff') ? '6' : '5' %>" class="text-center py-4">No
                                                                            devotees found.</td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
            </div>
        </div>
    </div>

    <!-- Add Modal -->
    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/dashboard/devotees/create" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Devotee</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Phone Number *</label>
                            <input type="text" class="form-control" name="phone_number" required placeholder="e.g. 918907959595">
                            <small class="text-muted">Digits with country code, no spaces or dashes.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">WhatsApp Name</label>
                            <input type="text" class="form-control" name="whatsapp_name" placeholder="e.g. Ravi Kumar">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Language</label>
                            <select class="form-select" name="language">
                                <option value="">— Not set —</option>
                                <% languages.forEach(lang => { %>
                                    <option value="<%= lang %>"><%= lang %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Devotee</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
